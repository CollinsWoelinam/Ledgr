{
  "expo": {
    "name": "Ledgr",
    "slug": "ledgr",
    "scheme": "ledgr",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.ledgr.app",
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0E2A22"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B221C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E2A22"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
